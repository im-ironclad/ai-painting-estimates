DATABASE_URL=postgres://paint_estimator:paint_estimator@localhost:5434/paint_estimator
REDIS_URL=redis://localhost:6380
UPLOAD_DIR=./uploads

# Paste your key here once you have it. Without it, photos fail with a clear error.
OPENROUTER_API_KEY=
# Primary vision model, then fallbacks OpenRouter tries in order.
VISION_MODEL=google/gemini-3.1-flash-lite
VISION_FALLBACK_MODELS=openai/gpt-5-mini
